# Copy to .env for local development. Never commit the real values - .env is
# ignored, and on Vercel these live in Settings -> Environment Variables.

# Where the contact form delivers. Without both of these, /api/contact answers
# 503 and the form says it is not connected.
#   TELEGRAM_BOT_TOKEN  @BotFather -> /newbot
#   TELEGRAM_CHAT_ID    message the bot, then read result[0].message.chat.id
#                       from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The public channel the photography section reads. Optional: both fall back
# to the values in server/api/photos.get.js.
# TELEGRAM_CHANNEL=StreetNote
# TELEGRAM_MAX_PHOTOS=20
